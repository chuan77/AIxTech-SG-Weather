# Copy this file to .env.local and adjust values.
# Option 1: set backend port (default backend host is localhost)
VITE_BACKEND_PORT=7999

# Option 2: set full API target (overrides VITE_BACKEND_PORT if set)
# VITE_API_TARGET=http://localhost:7999

# CARTO basemap API key for the map card (https://carto.com). Without it the
# map falls back to CARTO's keyless public tiles, which are for light use only.
# VITE_CARTO_API_KEY=
