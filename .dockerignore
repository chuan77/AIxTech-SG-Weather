# Keep secrets, local data and anything the image does not need out of the build context.
.git
.github
.env
.env.*
!.env.example
.vercel
.claude
.specify
specs
# docs/package.json stays: npm ci needs every workspace's manifest to match the lockfile.
docs/*
!docs/package.json
e2e-artifacts
RealtimeWeatherReadingsacrossSingapore
node_modules
**/node_modules
frontend/dist
backend/dist
backend/logs
backend/fixtures
*.db
*.db-shm
*.db-wal
.DS_Store
npm-debug.log*
