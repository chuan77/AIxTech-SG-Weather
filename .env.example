# Optional data.gov.sg API key for higher rate limits.
# The app works without this for light local usage.
WEATHER_API_KEY=

# Stable local browser URL used by scripts/dev.mjs through Portless.
PORTLESS_PORT=1355
PORTLESS_HTTPS=0

# Where the server listens (defaults shown). The container image sets HOST=0.0.0.0.
# HOST=127.0.0.1
# PORT=3000

# Optional path for the local SQLite database.
# DATABASE_PATH=backend/weather.db

# Hosted database (Turso). Leave commented out to use the local backend/weather.db.
# Set both or neither. Tests and browser checks always ignore these.
# TURSO_DATABASE_URL=libsql://XXXXXX
# TURSO_AUTH_TOKEN=XXXX

# Set in the container image; makes running without the hosted database an error.
# DATABASE_REQUIRE_REMOTE=true
